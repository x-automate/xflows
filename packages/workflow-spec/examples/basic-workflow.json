      "componentId": "OpenAIChat",
      "x": 520,
      "y": 140,
      "params": {
        "model": "gpt-4o-mini",
        "temperature": 0.3,
        "max_tokens": 256
      }
    },
    {
      "id": "node_output",
      "componentId": "Output",
      "x": 760,
      "y": 140,
      "params": {}
    }
