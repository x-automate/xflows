{
  "id": "wf_support_assistant",
  "name": "Support Assistant",
  "description": "Takes user input and returns an assistant response.",
  "version": 1,
  "status": "published",
  "nodes": [
    {
      "id": "node_input",
      "componentId": "Input",
      "x": 60,
      "y": 140,
      "params": {}
