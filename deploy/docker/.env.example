# Web/API
VITE_API_BASE_URL=http://localhost:8000
INTERNAL_API_TOKEN=replace-with-shared-secret
CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173
PERSISTENCE_MODE=postgres
PERSISTENCE_READS_FROM_SQL=true
SCHEMA_AUTO_MIGRATE=true
CACHE_TTL_SECONDS=30
IDEMPOTENCY_TTL_SECONDS=86400

# Core database
POSTGRES_USER=xflows
POSTGRES_PASSWORD=xflows_dev_password
POSTGRES_DB=xflows
DATABASE_URL=postgresql://xflows:xflows_dev_password@postgres:5432/xflows
REDIS_URL=redis://redis:6379/0

# LiteLLM and model provider credentials
LITELLM_MASTER_KEY=replace-me
OPENAI_API_KEY=replace-me-if-used

# Langfuse
LANGFUSE_DB=langfuse
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_SALT=replace-me
LANGFUSE_NEXTAUTH_SECRET=replace-me
CLICKHOUSE_PASSWORD=replace-me

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
